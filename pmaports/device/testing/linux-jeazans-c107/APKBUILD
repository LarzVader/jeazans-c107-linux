# Reference: <https://postmarketos.org/vendorkernel>
# Kernel und Konfiguration wie linux-postmarketos-stable (7.2.11), dazu
# der Geraetebaum des Tablets und die Akku-/Ladetreiber der AXP-PMIC.
# Gekuerzt (r1): nur die Allwinner-Plattform und ohne KALLSYMS_ALL, damit
# Kernel-Image und pmOS-Initramfs zusammen in boot_b (64 MiB) passen; der
# Hersteller-bootm nimmt nur unkomprimierte Kernel. BTF bleibt (kconfig check).
# ATH12K_AHB ist aus: ohne ARCH_QCOM zoege es qcom_scm und qcom_tzmem als
# Module nach, die sich gegenseitig brauchen (depmod-Zyklus).
# WLAN (r2): AIC8800D80-Treiber aus der RFC-Serie v3 von AICSemi fuer
# wireless-next (lore.kernel.org, cover.1787903339.git.yanli.yang@bedmex.com),
# Patch 0005 passt cfg80211_probe_status an 7.2 an, 0006 laesst den D80 mit
# Revision 7 zu (wie der Herstellertreiber, mit der U02-Firmware), 0007 laedt
# die BSP-Firmware ohne Geraet (sonst devres an SDIO-Funktion 1, -EBUSY), 0008
# verhindert den Oops bei einer Scan-Bestaetigung nach Abbruch, 0009 traegt
# change_station wieder ein (sonst bleibt der 802.1X-Kontrollport zu). Geraetebaum
# (r3) mit PMIC-Schienen, SDIO, PL7 (power_en) und PM1 (WL_REG_ON) als
# Regler. Firmware: firmware-jeazans-c107-aic8800.
# Display (r7): simpledrm uebernimmt das Bild, das der Hersteller-U-Boot auf
# dem Panel zeigt (Geraetebaum: simple-framebuffer, reserved-memory, Takte und
# Power-Domains der Anzeige, gpio-backlight an PH18), Terminus-Schrift 16x32.
# r8: FRAMEBUFFER_CONSOLE_ROTATION, damit fbcon=rotate:1 die Konsole quer stellt.
# Touch (r9): Treiber silead als Modul, Geraetebaum mit I2C0 (PH0/PH1), dem
# GSL3676 an 0x40 (Interrupt PH9, Wake PH10) und CLDO2 als Versorgung.
# r10: Touch-Achsen im DTS (Rohbereich 1664x896, getauscht und gespiegelt),
# Patch 0010 wiederholt die Silead-Initialisierung, wenn der Status nach dem
# Start nicht stimmt (nach warmem Neustart), GPU (Mali-G57) an DCDC2 eingeschaltet.
# r11: Patch 0010 schaltet vor jedem neuen Versuch auch die Versorgung aus (nur
# den Power-GPIO umzuschalten reichte nach warmem Neustart nicht).
# r12: DTS mit Bildspeicher 0xb1f13000 statt 0xb1f0e000 (mit Logos in
# bootloader_b liegt er dort), INPUT_AXP20X_PEK fuer die Ein/Aus-Taste.
# r13: Patch 0011 laesst den AIC-Treiber die MAC setzen (sonst wuerfelt die
# Firmware ohne eFuse-MAC bei jedem Start eine neue, und die IPv4 wechselt).
# r14: Akku, Ladegeraet und Messwerte der AXP717 im Geraetebaum, Ladeschluss 4,0 V.
# r15: Lautstaerketasten (KEYBOARD_SUN4I_LRADC) und Lagesensor SC7A20 an I2C1.
# r16: Patch 0012 meldet den simpledrm-Anschluss als DSI (KWin dreht nur interne
# Bildschirme automatisch), Einbaulage des Lagesensors im Geraetebaum.
# r17: Patch 0013 bringt den Uebernahme-Treiber sun55i_takeover (Seitenwechsel,
# vblank und Helligkeit auf der Anzeigekette, die der Hersteller-U-Boot laufen
# laesst; Geraetebaum: display@51c1000). Fuer die Tests ist der Kernel-Lockdown
# vorerst aus (LOCK_DOWN_KERNEL_FORCE_NONE), damit sich der Treiber ohne neuen
# Kernelbau austauschen laesst. Danach wieder einschalten.
# r18: Lockdown wieder an (Treiber getestet: Konsole, GPU, Desktop, Helligkeit,
# Bildschirm aus). Geraetebaum ohne gpio-backlight, PH18 schaltet der Treiber.
# Das Laden beim Start uebernimmt device-jeazans-c107.
# r19: Ton. Patches 0014 bis 0016 aus github.com/ut-slayer/orangepi-4a-mainline
# (dort 0081, 0084, 0111): Treiber sun55i-a523-codec, Portierung des Hersteller-
# Treibers mit Lautsprecher-Verstaerker, Mikrofonen und Buchsen-Erkennung.
# Mainline hat fuer den A523-Codec noch nichts, Chen-Yu Tsai arbeitet an einer
# Erweiterung von sun4i-codec; sobald die drin ist, darauf umsteigen.
maintainer="Lars <118484383+LarzVader@users.noreply.github.com>"
pkgname=linux-jeazans-c107
pkgver=7.2.11
pkgrel=19
_kver=${pkgver%.*}
pkgdesc="Jeazans C107 kernel (mainline)"
arch="aarch64"
_carch="arm64"
_flavor="jeazans-c107"
url="https://kernel.org"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-nftables
"
makedepends="
	bash
	bison
	clang
	clang-libclang
	diffutils
	elfutils-dev
	findutils
	flex
	grep
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	rust
	rust-bindgen
	rust-src
	rustfmt
	sed
	zstd
"
source="
	patch-$pkgver.patch.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/patch-$pkgver.xz
	linux-$_kver.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$_kver.tar.xz
	config-$_flavor.aarch64
	sun55i-a523-jeazans-c107.dts
	0001-wifi-aic-add-SDIO-BSP-and-build-configuration.patch
	0002-wifi-aic-add-FullMAC-firmware-and-platform-interface.patch
	0003-wifi-aic-add-FullMAC-WLAN-driver.patch
	0004-wifi-aic-integrate-AIC8800-driver.patch
	0005-wifi-aic-build-on-linux-7.2.patch
	0006-wifi-aic-accept-AIC8800D80-revision-7.patch
	0007-wifi-aic-load-BSP-firmware-without-device.patch
	0008-wifi-aic-ignore-scan-confirm-after-abort.patch
	0009-wifi-aic-keep-change_station-in-station-mode.patch
	0010-Input-silead-retry-setup-if-the-status-check-fails.patch
	0011-wifi-aic-allow-setting-the-MAC-address.patch
	0012-drm-sysfb-simpledrm-report-the-connector-as-DSI.patch
	0013-drm-sun4i-add-a-display-takeover-driver-for-the-Jeazans-C107.patch
	0014-ASoC-sunxi-new-driver-for-the-A523-T527-internal-codec.patch
	0015-ASoC-sunxi-sun55i-a523-codec-quiesce-the-jack-before-the-card.patch
	0016-ASoC-sunxi-sun55i-a523-codec-cancel-jack-scan-work-on-probe-failure.patch
"
builddir="$srcdir/linux-$_kver"

prepare() {
	default_prepare

	# Geraetebaum des Tablets einhaengen (noch nicht im Hauptkernel)
	cp "$srcdir"/sun55i-a523-jeazans-c107.dts arch/arm64/boot/dts/allwinner/
	echo 'dtb-$(CONFIG_ARCH_SUNXI) += sun55i-a523-jeazans-c107.dtb' \
		>> arch/arm64/boot/dts/allwinner/Makefile

	cp "$srcdir/config-$_flavor.$CARCH" .config
	# Die Konfiguration ist die von linux-postmarketos-stable plus die
	# AXP-Akkutreiber, ab r1 ohne fremde Plattformen (ARCH_* ausser SUNXI);
	# olddefconfig loest die Abhaengigkeiten dazu auf.
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

