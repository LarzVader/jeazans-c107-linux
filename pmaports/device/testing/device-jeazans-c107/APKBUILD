# Reference: <https://postmarketos.org/devicepkg>
maintainer="Lars <118484383+LarzVader@users.noreply.github.com>"
pkgname=device-jeazans-c107
pkgdesc="Jeazans C107"
pkgver=1
pkgrel=13
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# WLAN-Firmware (AIC8800D80) und Touch-Firmware (GSL3676) gleich mitnehmen,
# ohne sie bleiben wlan0 und der Touchscreen aus
depends="
	firmware-jeazans-c107-aic8800
	firmware-jeazans-c107-gslx680
	alsa-ucm-conf
	linux-jeazans-c107
	postmarketos-base
"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf 90-jeazans-c107-watchdog.conf 60-jeazans-c107-wlan.conf
	jeazans-c107-npu.conf jeazans-c107-sleep.conf jeazans-c107-akku-halten.sh
	jeazans-c107-akku-halten.service jeazans-c107-anzeige.conf audiocodec.conf
	audiocodec-HiFi.conf"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Neustart und Haenger auch ueber sunxi-wdt: der PSCI-Reset der Firmware
	# hing ohne clk_ignore_unused, der Watchdog bleibt als Rueckfall
	install -Dm644 "$srcdir"/90-jeazans-c107-watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/90-jeazans-c107-watchdog.conf

	# wlan0 bekommt pro Verbindung eine feste MAC ("stable", siehe Datei)
	install -Dm644 "$srcdir"/60-jeazans-c107-wlan.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/60-jeazans-c107-wlan.conf

	# NPU (etnaviv) sperren, damit Mesa fuer simpledrm die Mali-GPU nimmt
	install -Dm644 "$srcdir"/jeazans-c107-npu.conf \
		"$pkgdir"/usr/lib/modprobe.d/jeazans-c107-npu.conf

	# Anzeige-Treiber laden, bevor der Desktop kommt: KWin zieht nicht von
	# simpledrm um, wenn er schon laeuft
	install -Dm644 "$srcdir"/jeazans-c107-anzeige.conf \
		"$pkgdir"/usr/lib/modules-load.d/jeazans-c107-anzeige.conf

	# Tonprofil fuer den eingebauten Codec (Kartenname "audiocodec")
	install -Dm644 "$srcdir"/audiocodec.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/audiocodec/audiocodec.conf
	install -Dm644 "$srcdir"/audiocodec-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/audiocodec/HiFi.conf

	# Kein Ruhezustand: Server, und auf diesem Kernel noch nicht erprobt
	install -Dm644 "$srcdir"/jeazans-c107-sleep.conf \
		"$pkgdir"/usr/lib/systemd/sleep.conf.d/90-jeazans-c107.conf

	# Akku im Dauerbetrieb bei rund 3,8 V halten, von Anfang an eingeschaltet
	install -Dm755 "$srcdir"/jeazans-c107-akku-halten.sh \
		"$pkgdir"/usr/libexec/jeazans-c107-akku-halten
	install -Dm644 "$srcdir"/jeazans-c107-akku-halten.service \
		"$pkgdir"/usr/lib/systemd/system/jeazans-c107-akku-halten.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../jeazans-c107-akku-halten.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/jeazans-c107-akku-halten.service
}

